{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "575280fd-0dc1-4c74-929f-d5724f5f0dbe"
  },
  "newProjectRoot": "projects",
  "projects": {
    "@geodienst/dashkit": {
      "projectType": "library",
      "root": "projects/geodienst/dashkit",
      "sourceRoot": "projects/geodienst/dashkit",
      "prefix": "gd",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/geodienst/dashkit/tsconfig.lib.json",
            "outputPath": "dist/geodienst/dashkit",
            "assets": [
              { "glob": "*.xlf", "input": "projects/geodienst/dashkit/src/lib/locale", "output": "locale" },
              { "glob": "LICENSE", "input": ".", "output": "." }
            ],
            "allowedNonPeerDependencies": ["marked"]
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/geodienst/dashkit/tsconfig.spec.json",
            "polyfills": ["@angular/localize/init"]
          }
        }
      }
    }
  }
}
